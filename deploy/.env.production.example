LAJUANA_API_IMAGE=ghcr.io/OWNER/lajuana-api:1.0.0

APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_ORIGIN_REGEX=

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
DATABASE_NAME=lajuana

AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
PARTICIPANT_FORM_TOKEN_SECRET=replace-with-at-least-32-random-characters
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-fernet-key

WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_SEND_ENABLED=false

STORAGE_S3_BUCKET=lajuana-files
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
FILES_BASE_URL=https://files.example.com

GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
