<?xml version="1.0" encoding="utf-8"?>
<!-- Producción: todo el tráfico debe usar TLS. Los recursos de debug/profile
     reemplazan este archivo para permitir desarrollo contra una API local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
