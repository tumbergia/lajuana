APP_NAME=La Juana API
APP_VERSION=0.1.0
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
API_VERSION=v1

MONGODB_URI=
DATABASE_NAME=

# Assistant / MCP
ASSISTANT_ENABLE_LLM=false
ASSISTANT_DEFAULT_MIN_NOTICE_DAYS=7

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false

FILES_BASE_URL=http://localhost/files
