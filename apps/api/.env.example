APP_NAME=La Juana API
APP_VERSION=0.1.0
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
API_VERSION=v1

MONGODB_URI=
DATABASE_NAME=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30

# Assistant
ASSISTANT_TOOL_RESPONSE_MODE=cheap
ASSISTANT_DEFAULT_MIN_NOTICE_DAYS=7
ASSISTANT_MIN_PLAN_CONFIDENCE=0.55

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false

FILES_BASE_URL=http://localhost/files
