APP_NAME=La Juana API
APP_VERSION=0.1.0
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
API_VERSION=v1

MONGODB_URI=
DATABASE_NAME=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30

# Assistant
ASSISTANT_TOOL_RESPONSE_MODE=cheap
ASSISTANT_DEFAULT_MIN_NOTICE_DAYS=7
ASSISTANT_MIN_PLAN_CONFIDENCE=0.55

# RAG / base de conocimiento (embeddings Gemini + similitud coseno en Mongo).
# Reutiliza GEMINI_API_KEY. No requiere MongoDB Atlas.
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_SEARCH_TOP_K=4
RAG_MIN_SIMILARITY=0.55
RAG_MAX_DOCUMENT_BYTES=10485760

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false

# Catálogo de experiencias enviable por WhatsApp (documento PDF).
# El archivo debe existir en el storage configurado bajo STORAGE_KEY.
WHATSAPP_EXPERIENCES_CATALOG_ENABLED=true
WHATSAPP_EXPERIENCES_CATALOG_STORAGE_KEY=catalogs/experiencias-muleras.pdf
WHATSAPP_EXPERIENCES_CATALOG_FILENAME=Experiencias-La-Juana.pdf
WHATSAPP_EXPERIENCES_CATALOG_CAPTION=Catálogo de experiencias muleras de La Juana 🐴
WHATSAPP_EXPERIENCES_CATALOG_MIME_TYPE=application/pdf

FILES_BASE_URL=http://localhost/files
