APP_NAME=La Juana API
APP_VERSION=0.1.0
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
API_VERSION=v1

MONGODB_URI=
DATABASE_NAME=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SECONDS=30
AI_CONFIG_ENCRYPTION_KEY=

# Assistant
ASSISTANT_TOOL_RESPONSE_MODE=cheap
ASSISTANT_DEFAULT_MIN_NOTICE_DAYS=7
ASSISTANT_MIN_PLAN_CONFIDENCE=0.55

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false

FILES_BASE_URL=http://localhost/files

# Speech-to-Text (faster-whisper)
# Modelos válidos: tiny | base | small | medium | large-v3
# "small" es el mínimo recomendado para multilingüe confiable (zh/ru/ja/en/es).
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Vacío = auto-detección del idioma por Whisper (recomendado).
# Forzar un código (es, en, zh, ...) hace que Whisper decodifique siempre en
# ese idioma y produzca alucinaciones en audios de otros idiomas.
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
